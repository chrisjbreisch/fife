// Collections: List, Stack, Queue, and Map.

// List: resizable, index-accessible.
var names = List("Ann", "Bo", "Cy")
names.add("Dee")
Con.writeln(names)                 // [Ann, Bo, Cy, Dee]
Con.writeln(names.length)          // 4
Con.writeln(names[0])              // Ann
names[0] = "Annie"
Con.writeln(names.contains("Bo"))  // true
Con.writeln(names.indexOf("Cy"))   // 2
names.remove("Bo")
Con.writeln(names)                 // [Annie, Cy, Dee]

for (var i = 0; i < names.length; i = i + 1) {
  Con.writeln("  " + i + ": " + names[i])
}

// Stack: last in, first out.
var stack = Stack(1, 2)
stack.push(3)
Con.writeln(stack.pop())    // 3
Con.writeln(stack.peek())   // 2
Con.writeln(stack.isEmpty()) // false

// Queue: first in, first out.
var queue = Queue(1, 2)
queue.enqueue(3)
Con.writeln(queue.dequeue()) // 1
Con.writeln(queue.peek())    // 2

// Map: keyed lookup.
var ages = Map()
ages.set("Ann", 30)
ages["Bo"] = 25
Con.writeln(ages.get("Ann"))       // 30
Con.writeln(ages["Bo"])            // 25
Con.writeln(ages.containsKey("Cy")) // false
Con.writeln(ages.length)           // 2

var keys = ages.keys()
for (var i = 0; i < keys.length; i = i + 1) {
  Con.writeln(keys[i] + " is " + ages.get(keys[i]))
}
