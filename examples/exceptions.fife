// Exceptions: throw, try/catch, and the built-in Exception hierarchy.

class InvalidInputException : Exception {
}

fun requirePositive(n) {
  if (n < 0) throw InvalidInputException("must be positive, got " + n)
  return n
}

try {
  requirePositive(-5)
} catch (Exception e) {
  writeln("caught: " + e.message)
}

// A catch (Exception e) catches every built-in and user-defined subclass.
try {
  throw Exception("something went wrong")
} catch (Exception e) {
  writeln("caught: " + e.message)
}

// File and Web failures are also catchable, since FileException and WebException
// are both built-in subclasses of Exception.
try {
  File("no-such-file.txt").read()
} catch (Exception e) {
  writeln("caught: " + e.message)
}

// An exception that no enclosing catch matches stops the program.
// (Left commented out so this file runs to completion.)
// throw Exception("uncaught")

writeln("done")
