// A quick tour of what fife can do today.

writeln("hello from fife")

var greeting = "hi"
var name = "world"
writeln(greeting + ", " + name + "!")

// Blocks and scoping.
{
  var name = "block"
  writeln(greeting + ", " + name + "!")
}

// Control flow.
for (var i = 1; i <= 5; i = i + 1) {
  if (i < 3) writeln("small: " + i)
  else writeln("big: " + i)
}

var n = 3
while (n > 0) {
  writeln(n)
  n = n - 1
}

// Functions and closures.
int fun fib(int n) {
  if (n < 2) return n
  return fib(n - 1) + fib(n - 2)
}

for (var i = 0; i < 10; i = i + 1) writeln(fib(i))

fun makeCounter() {
  int count = 0
  fun increment() {
    count = count + 1
    return count
  }
  return increment
}

var counter = makeCounter()
writeln(counter())
writeln(counter())

// Classes and inheritance.
class Animal {
  Animal(name) {
    this.name = name
  }

  speak() {
    writeln(this.name + " makes a sound")
  }
}

class Dog : Animal {
  Dog(name) {
    super.Animal(name)
  }

  speak() {
    super.speak()
    writeln(this.name + " barks")
  }
}

Dog("Rex").speak()

// Native functions provided by the host.
writeln(clock())
